# HTCondor submit file of the SV MaskFormer training on the CERN GPU batch (submit from lxplus, in the repo root):
#   mkdir -p logs/condor
#   condor_submit jobs/train_sv_condor.sub                              # full training, configs/sv/gv_tracks.yaml
#   condor_submit jobs/train_sv_condor.sub smoke=1 flavour=longlunch    # 3-batch validation of the whole chain
#   condor_submit jobs/train_sv_condor.sub name=sv_gv_tracks_v2 extra="--max-epochs 20"
#   condor_submit jobs/train_sv_condor.sub run_dir=<runs_root>/job_<cluster>/<run> flavour=longlunch   # evaluate only
#   condor_submit jobs/train_sv_condor.sub config=<config> name=<name> resume=<runs_root>/job_<cluster>/<run>   # resume
# The job (jobs/train_sv_condor.sh) trains, evaluates the best checkpoint on the test split and publishes the plots
# on the EOS web area, with the Kerberos credential condor delegates to it (MY.SendCredential). Progress:
#   condor_q; tail -f logs/condor/<name>_<cluster>.out; cat <runs_root>/job_<cluster>/STATUS
# Defaults, each overridable on the command line (condor_submit ... var=value); an unconditional assignment here
# would win over the command line.
if ! defined repo
  repo = /afs/cern.ch/work/m/mmarcheg/private/ml4reco/sv-maskformer
endif
if ! defined config
  config = configs/sv/gv_tracks.yaml
endif
if ! defined name
  name = sv_gv_tracks
endif
if ! defined runs_root
  runs_root = /eos/user/m/mmarcheg/BTV/sv_reconstruction/runs
endif
if ! defined www_root
  www_root = /eos/user/m/mmarcheg/www/plots/ml4reco/sv-maskformers
endif
if ! defined smoke
  smoke = 0
endif
if ! defined extra
  extra =
endif
if ! defined flavour
  flavour = testmatch
endif
# run_dir=<runs_root>/job_<cluster>/<name>_<timestamp>: skip the training and only evaluate that run (plots again)
if ! defined run_dir
  run_dir = -
endif
# resume=<checkpoint .ckpt, or a run folder: its last epoch>: continue a stopped training (wall time, eviction, crash)
# from that checkpoint, with the config and name of the stopped run; the run continues in a new job_<cluster> folder.
# STATUS of a job condor stopped reads KILLED and names the checkpoint to resume from.
if ! defined resume
  resume = -
endif

executable = $(repo)/jobs/train_sv_condor.sh
arguments  = "$(repo) $(config) $(name) $(runs_root) $(www_root) $(smoke) $(ClusterId) $(run_dir) $(resume) $(extra)"
initialdir = $(repo)
output     = logs/condor/$(name)_$(ClusterId).out
error      = logs/condor/$(name)_$(ClusterId).err
log        = logs/condor/$(name)_$(ClusterId).log

# CERN's submit transforms add 2 CPUs and 2 GB per GPU; the GPU slots leave few CPUs free, so ask for little
request_gpus   = 1
request_cpus   = 2
request_memory = 8000
# Any A100 / H100 / H200 (compute capability >= 8: flash attention + bf16) or T4 (7.5: the job falls back to the
# torch attention backend and fp32); higher capability preferred. The image's PyTorch supports capability 7.5 to
# 12.0, so the V100s (7.0, "no kernel image is available") are excluded, as are the MIG slices (undefined
# capability). At submission time (2026-11-07) every usable A100 of the pool was claimed and the free H100/H200
# nodes had START = false, so a job may queue until a GPU frees up.
requirements   = (TARGET.GPUs_Capability >= 7.5)
rank           = TARGET.GPUs_Capability
+JobFlavour    = "$(flavour)"
# Kerberos credential in the job: EOS (data, outputs, plots) and AFS (the code)
MY.SendCredential = True

should_transfer_files = YES
transfer_executable   = True
transfer_output_files = ""
queue
